# How to cite GEMsMAP: https://gemsmap.readthedocs.io/en/latest/reference/how-to-cite/
# Keep `version` and `date-released` in step with backend/gemsmap/__init__.py (tools/release/build.py checks the version).
# After each release, set `doi` and the first `identifiers` entry to that version's Zenodo DOI; when the article is
# published, add it as `preferred-citation`.
cff-version: 1.2.0
message: "If you use GEMsMAP, please cite the version you used, and the tools it builds on (COBRApy and, when used, MetaNetX, BiGG and KEGG)."
type: software
title: "GEMsMAP: integrating constraint-based modeling, metabolic visualization and identity-aware pathway templates"
abstract: "GEMsMAP connects constraint-based computation with COBRApy, reaction and metabolite exploration, and editable metabolic maps in one application, with identity-aware pathway templates that can be applied to different genome-scale metabolic models."
authors:
  - family-names: Batista
    given-names: Bruno
    orcid: "https://orcid.org/0000-0002-2449-8304"
    affiliation: "University of Campinas (UNICAMP), Campinas, Brazil"
  - family-names: "de Carvalho"
    given-names: "Lucas Miguel"
    orcid: "https://orcid.org/0000-0002-8766-0452"
    affiliation: "Universidade São Francisco (USF), Bragança Paulista, Brazil"
  - family-names: Damasio
    given-names: "André"
    orcid: "https://orcid.org/0000-0001-9304-3998"
    affiliation: "University of Campinas (UNICAMP), Campinas, Brazil"
version: 0.3.0
date-released: 2026-11-19
doi: 10.5281/zenodo.24383709
identifiers:
  - type: doi
    value: 10.5281/zenodo.24383709
    description: "GEMsMAP 0.3.0 on Zenodo"
  - type: doi
    value: 10.5281/zenodo.24383708
    description: "All versions of GEMsMAP on Zenodo (concept DOI, resolves to the newest)"
license: MIT
repository-code: "https://github.com/BatistaB/gemsmap"
url: "https://gemsmap.readthedocs.io/"
keywords:
  - genome-scale metabolic model
  - constraint-based modeling
  - flux balance analysis
  - COBRApy
  - metabolic maps
  - pathway visualization
